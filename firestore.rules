rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an authorized admin
    function isAuthorizedAdmin() {
      return request.auth != null && 
        (
          request.auth.token.email.lower() == 'abhikumar3584@gmail.com'
          // Future admin emails can be added here
        );
    }

    // 1. Talent Requests Collection (From "Request Talent Now")
    match /talent_requests/{docId} {
      // Anyone can submit a hiring request
      allow create: if true;
      // Only verified Admin can read, update status, or delete
      allow read, update, delete: if isAuthorizedAdmin();
    }

    // 2. Talent Applications Collection (From "Join Talent Network")
    match /talent_applications/{docId} {
      // Anyone can submit candidate application
      allow create: if true;
      // Only verified Admin can read, update status, or delete
      allow read, update, delete: if isAuthorizedAdmin();
    }

    // 3. Instant Inquiries Collection (From "Contact Us" page)
    match /inquiries/{docId} {
      // Anyone can submit an inquiry
      allow create: if true;
      // Only verified Admin can read, update status, or delete
      allow read, update, delete: if isAuthorizedAdmin();
    }
  }
}
